{
  "name": "agent-desk",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local agent harness for Codex and Claude (v2 in progress; v1 lives in legacy/)",
  "engines": { "node": ">=22.18" },
  "imports": {
    "#core": "./packages/core/src/index.ts",
    "#core/*": "./packages/core/src/*",
    "#runtime-fake": "./packages/runtime-fake/src/index.ts",
    "#tools-mcp": "./packages/tools-mcp/src/index.ts",
    "#runtime-codex": "./packages/runtime-codex/src/index.ts",
    "#orchestrator": "./packages/orchestrator/src/index.ts",
    "#store": "./packages/store/src/index.ts",
    "#cli": "./packages/cli/src/main.ts"
  },
  "scripts": {
    "agent-desk": "node packages/cli/src/bin.ts",
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "legacy:start": "npm --prefix legacy start",
    "legacy:check": "npm --prefix legacy run check",
    "legacy:test": "npm --prefix legacy test",
    "bench:validate": "node bench/validate-tasks.mjs",
    "bench:selftest": "node bench/selftest.mjs",
    "bench:run": "node bench/run.mjs",
    "bench:report": "node bench/report.mjs",
    "bench:history": "node bench/analyze-history.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
